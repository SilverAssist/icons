{
  "name": "@silverassist/icons",
  "version": "0.1.1",
  "description": "Icon library for SilverAssist - Next.js compatible React icon components",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilverAssist/icons.git"
  },
  "bugs": {
    "url": "https://github.com/SilverAssist/icons/issues"
  },
  "homepage": "https://github.com/SilverAssist/icons#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,tsx,json,md}\"",
    "prepublishOnly": "npm run build",
    "convert-svg": "node scripts/convert-svg.js",
    "generate-list": "node scripts/generate-icons-list.js",
    "bulk-convert": "node scripts/bulk-convert.js",
    "check": "npm run format:check && npm run typecheck && npm run lint",
    "prepare": "husky || true",
    "e2e:setup": "next-testing-toolkit build-fixture --port 3212",
    "e2e": "npm run e2e:setup && playwright test -c e2e/playwright.config.ts"
  },
  "keywords": [
    "react",
    "icons",
    "nextjs",
    "svg",
    "silver",
    "components"
  ],
  "author": "Miguel Colmenares <me@miguelcolmenares.com>",
  "license": "Polyform Noncommercial License 1.0.0",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@silverassist/next-testing-toolkit": "^0.2.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.7",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.6.2",
    "react": "^19.2.3",
    "tsdown": "^0.22.14",
    "tsx": "^4.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.48.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
